+// ARTEMIS-PATCH : /clear, /usage, /opus, /sonnet et vocaux. Écrasé à chaque mise à jour du plugin :
+// relancer patch-telegram.sh (dépôt Artemis). Variables exportées par artemis.sh depuis son .env.
+const TMUX_TARGET = process.env.TMUX_SESSION || 'artemis'
+const ARTEMIS_DIR = process.env.ARTEMIS_DIR || join(homedir(), 'artemis')
+function tmuxKeys(...args: string[]): void {
+  execFileSync('tmux', ['send-keys', '-t', TMUX_TARGET, ...args])
+}
+function typeSlash(cmd: string): void {
+  tmuxKeys('-l', cmd)
+  tmuxKeys('Enter')
+}
+
+bot.command('clear', async ctx => {
+  const gated = dmCommandGate(ctx)
+  if (!gated || !gated.access.allowFrom.includes(gated.senderId)) return
+  try {
+    typeSlash('/clear')
+  } catch (e) {
+    await ctx.reply(`Échec /clear : ${e}`)
+    return
+  }
+  const deleted = await wipeChat(ctx.chat!.id, ctx.message!.message_id)
+  await ctx.reply(`Contexte vidé, ${deleted} messages effacés.`)
+})
+
+// Les ids d'un chat privé se suivent : on efface à l'aveugle de l'id courant jusqu'à 1 (toute la conversation).
+// Telegram refuse au-delà de 48 h : on s'arrête au premier lot refusé.
+async function wipeChat(chatId: number, fromId: number): Promise<number> {
+  const floor = 0
+  let count = 0
+  for (let hi = fromId; hi > floor; hi -= 100) {
+    const ids: number[] = []
+    for (let id = hi; id > Math.max(floor, hi - 100); id--) ids.push(id)
+    try {
+      await bot.api.deleteMessages(chatId, ids)
+      count += ids.length
+    } catch (e) {
+      process.stderr.write(`wipeChat stop at ${hi}: ${e}\n`)
+      break
+    }
+  }
+  return count
+}
+
+bot.command('usage', async ctx => {
+  const gated = dmCommandGate(ctx)
+  if (!gated || !gated.access.allowFrom.includes(gated.senderId)) return
+  try {
+    typeSlash('/usage')
+    await new Promise(r => setTimeout(r, 4000))
+    const pane = execFileSync('tmux', ['capture-pane', '-pt', TMUX_TARGET], { encoding: 'utf8' })
+    tmuxKeys('Escape')
+    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    const lines = pane.split('\n').map(l => l.trim()).filter(Boolean)
+    const bar = (p: number) => '█'.repeat(Math.round(p / 10)) + '░'.repeat(10 - Math.round(p / 10))
+    const out: string[] = ['📊 <b>Usage Artemis</b>']
+    for (let i = 1; i < lines.length; i++) {
+      const m = lines[i]!.match(/(\d+)% used/)
+      if (!m) continue
+      const label = lines[i - 1]!.startsWith('Current') ? lines[i - 1]! : lines[i - 2] ?? ''
+      const reset = lines[i + 1]?.startsWith('Resets') ? lines[i + 1]!.replace('Resets ', '') : ''
+      out.push(`\n<b>${esc(label.replace(/^Current /, '').replace(/^./, c => c.toUpperCase()))}</b>\n<code>${bar(Number(m[1]))}</code> <b>${m[1]}%</b>${reset ? '\n↻ ' + esc(reset) : ''}`)
+    }
+    const tips = lines.filter(l => /^\d+%\s+\S/.test(l)).slice(0, 3)
+    if (tips.length) out.push('\n<b>Ce qui consomme</b>\n' + tips.map(t => '• ' + esc(t.replace(/\s+/, ' '))).join('\n'))
+    if (out.length === 1) out.push('<pre>' + esc(lines.join('\n').slice(0, 1900) || '(écran vide)') + '</pre>')
+    await ctx.reply(out.join('\n'), { parse_mode: 'HTML' })
+  } catch (e) {
+    await ctx.reply(`Échec /usage : ${e}`)
+  }
+})
+
+// /opus et /sonnet : bascule la session entière (la conversation est gardée), puis renvoie la ligne d'état.
+for (const model of ['opus', 'sonnet']) {
+  bot.command(model, async ctx => {
+    const gated = dmCommandGate(ctx)
+    if (!gated || !gated.access.allowFrom.includes(gated.senderId)) return
+    // /model enregistre aussi le modèle comme défaut global dans settings.json : on remet la valeur d'avant,
+    // sinon toutes les autres sessions changeraient de modèle.
+    const SETTINGS = join(homedir(), '.claude', 'settings.json')
+    const MODEL_RE = /"model":\s*"[^"]*"/
+    const saved = readFileSync(SETTINGS, 'utf8').match(MODEL_RE)?.[0]
+    try {
+      typeSlash(`/model ${model}`)
+      await new Promise(r => setTimeout(r, 2000))
+      if (saved) {
+        const now = readFileSync(SETTINGS, 'utf8')
+        if (now.match(MODEL_RE)?.[0] !== saved) writeFileSync(SETTINGS, now.replace(MODEL_RE, saved))
+      }
+      const pane = execFileSync('tmux', ['capture-pane', '-pt', TMUX_TARGET], { encoding: 'utf8' })
+      const line = pane.split('\n').reverse().find(l => /model|modèle|effort/i.test(l))?.trim()
+      await ctx.reply(line || `/model ${model} envoyé.`)
+    } catch (e) {
+      await ctx.reply(`Échec /${model} : ${e}`)
+    }
+  })
+}
