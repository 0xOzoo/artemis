+// Claude ne peut ni écouter ni regarder → vocaux/vidéos transcrits par Whisper (voice/media.py,
+// installé par ./install.sh --voice) et vidéos résumées en une planche de 6 images envoyée comme image_path.
+const MEDIA_KINDS = new Set(['voice', 'audio', 'video', 'video_note'])
+const MEDIA_PY = join(ARTEMIS_DIR, 'voice', 'media.py')
+const MEDIA_VENV_PY = join(ARTEMIS_DIR, '.venv', 'bin', 'python')
+async function describeMedia(fileId: string): Promise<{ note: string, sheet?: string }> {
+  try { statSync(MEDIA_VENV_PY) } catch {
+    return { note: "Vocaux/vidéos non activés sur cette machine (./install.sh --voice) : contenu non lu." }
+  }
+  try {
+    const file = await bot.api.getFile(fileId)
+    if (!file.file_path) throw new Error('pas de file_path')
+    const res = await fetch(`https://api.telegram.org/file/bot${TOKEN}/${file.file_path}`)
+    if (!res.ok) throw new Error(`HTTP ${res.status}`)
+    const ext = (file.file_path.split('.').pop() ?? 'bin').replace(/[^a-zA-Z0-9]/g, '') || 'bin'
+    const path = join(INBOX_DIR, `${Date.now()}-${(file.file_unique_id ?? 'dl').replace(/[^a-zA-Z0-9_-]/g, '')}.${ext}`)
+    mkdirSync(INBOX_DIR, { recursive: true })
+    writeFileSync(path, Buffer.from(await res.arrayBuffer()))
+    const { stdout } = await promisify(execFile)(MEDIA_VENV_PY, ['-I', MEDIA_PY, path], { timeout: 600_000 })
+    const r = JSON.parse(stdout) as { transcript: string, sheet: string | null }
+    const parts = [`Fichier : ${path}`]
+    parts.push(r.transcript ? `Transcription (Whisper, peut contenir des erreurs) : « ${r.transcript} »` : 'Aucune parole détectée.')
+    if (r.sheet) parts.push('image_path = planche de 6 images réparties sur la vidéo.')
+    return { note: parts.join('\n'), sheet: r.sheet ?? undefined }
+  } catch (e) {
+    // Telegram refuse au bot les fichiers > 20 Mo : ça finit ici.
+    return { note: `Transcription impossible : ${e}` }
+  }
+}
