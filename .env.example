# Copier en .env (cp .env.example .env), remplir, puis lancer ./install.sh.
# Ne jamais committer .env : il contient le jeton du bot.

# Jeton donné par @BotFather sur Telegram (forme 123456789:ABC-def...).
TELEGRAM_BOT_TOKEN=

# Modèle et effort de la session Artemis (sonnet|opus, low|medium|high).
ARTEMIS_MODEL=sonnet
ARTEMIS_EFFORT=medium

# Coffre Obsidian (second cerveau). Créé vide s'il n'existe pas ; jamais écrasé s'il existe.
VAULT_NAME=cerveau
VAULT_DIR="$HOME/cerveau"

# Nom de la session tmux où tourne Artemis (tmux attach -t artemis pour la voir).
TMUX_SESSION=artemis

# --- Facultatif ---------------------------------------------------------------

# Suivi de colis (skill suivi-colis). Clé API Ship24 : crée un compte gratuit sur https://www.ship24.com,
# récupère la clé API dans son tableau de bord. Vide = seul Colis Privé est suivi, et pas d'alerte automatique.
# Remplie = ./install.sh active un timer qui envoie sur Telegram chaque changement de statut (toutes les 30 min).
SHIP24_API_KEY=
# Destinataire des alertes colis. Vide = le premier compte appairé au bot.
TELEGRAM_CHAT_ID=

# Discord (second canal, à côté de Telegram). Jeton : Discord Developer Portal → ton application → Bot → Reset Token
# (active aussi « Message Content Intent »). Vide = pas de Discord.
DISCORD_BOT_TOKEN=
# Obligatoire si DISCORD_BOT_TOKEN est rempli : IDs utilisateur Discord autorisés, séparés par des virgules
# (Discord → Paramètres → Avancés → Mode développeur, puis clic droit sur ton nom → Copier l'identifiant).
# Seuls ces comptes, en message privé au bot, atteignent Artemis ; les autres sont ignorés sans réponse.
DISCORD_ALLOWED_USERS=

# Vocaux (./install.sh --voice) : modèle Whisper (tiny|base|small|medium). Plus gros = plus juste et plus lent.
WHISPER_MODEL=small
